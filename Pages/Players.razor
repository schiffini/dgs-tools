@page "/reportes/players"
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable
@inject PlayerService PlayerService
@inject ILogger<Players> Logger

<MudText Typo="Typo.h4" Class="mb-4">Players</MudText>

<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    Esta vista incluye credenciales de players (Password / Password Online). Acceso restringido a Admin.
</MudAlert>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudTextField @bind-Value="search" Placeholder="Buscar por usuario o nombre..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchChanged" T="string" Class="w-100" />
</MudPaper>

<MudTable ServerData="ServerReload" Dense="true" Hover="true" Striped="true" @ref="table">
    <HeaderContent>
        <MudTh Style="width: 48px;"></MudTh>
        <MudTh>Id</MudTh>
        <MudTh>Player</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Password</MudTh>
        <MudTh>Online Password</MudTh>
        <MudTh>Line Type</MudTh>
        <MudTh>Profile</MudTh>
        <MudTh>Book</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>IdAgent</MudTh>
        <MudTh>Agent</MudTh>
        <MudTh>Balance</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudIconButton Icon="@(context.IsExpanded ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)"
                           Size="Size.Small" Color="Color.Primary"
                           OnClick="@(() => context.IsExpanded = !context.IsExpanded)" />
        </MudTd>
        <MudTd DataLabel="Id">@context.Id</MudTd>
        <MudTd DataLabel="Player">@context.Username</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Password">@context.Password</MudTd>
        <MudTd DataLabel="Online Password">@context.OnlinePassword</MudTd>
        <MudTd DataLabel="LineType">@context.LineTypeId</MudTd>
        <MudTd DataLabel="IdProfile">@context.ProfileId</MudTd>
        <MudTd DataLabel="IdBook">@context.BookId</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Status">@context.Status</MudTd>
        <MudTd DataLabel="IdAgent">@context.AgentId</MudTd>
        <MudTd DataLabel="Agent">@context.Agent?.Name</MudTd>
        <MudTd DataLabel="Balance">
            <MudChip T="string" Size="Size.Small" Style="@GetBalanceChipStyle(context.Id)">@GetBalanceText(context.Id)</MudChip>
            @if (consecutiveFailures >= StaleFailureThreshold)
            {
                <MudTooltip Text="Saldo desactualizado">
                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Size="Size.Small" Color="Color.Warning" Class="ml-1" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (context.IsExpanded)
        {
            <MudTr>
                <td colspan="14">
                    <MudSimpleTable Dense="true" Elevation="0" Class="ma-2">
                        <tbody>
                            <tr><th>Credit Limit</th><td>@context.CreditLimit.ToString("N2")</td><th>Temp Credit</th><td>@context.TempCredit.ToString("N2")</td></tr>
                            <tr><th>Online Access</th><td>@(context.OnlineAccess ? "Sí" : "No")</td><th>Profile Limits</th><td>@context.ProfileLimitsId</td></tr>
                            <tr><th>Online Max Wager</th><td>@context.OnlineMaxWager.ToString("N2")</td><th>Online Min Wager</th><td>@context.OnlineMinWager.ToString("N2")</td></tr>
                            <tr><th>Max Wager</th><td>@context.MaxWager.ToString("N2")</td><th>Min Wager</th><td>@context.MinWager.ToString("N2")</td></tr>
                            <tr><th>Free Play Amount</th><td>@context.FreePlayAmount.ToString("N2")</td><th>Settled Figure</th><td>@context.SettledFigure.ToString("N2")</td></tr>
                            <tr><th>Last Modification User</th><td>@context.LastModificationUserId</td><td></td><td></td></tr>
                        </tbody>
                    </MudSimpleTable>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Align="Align.Center">No se encontraron players.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {
    private const string PositiveColor = "#2E8B57";
    private const string NegativeColor = "#C0392B";
    private const string MutedColor = "#9AA5AF";
    private const int StaleFailureThreshold = 3;
    private static readonly System.Globalization.CultureInfo BalanceCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private MudTable<Player> table = null!;
    private string search = string.Empty;

    private List<int> currentPlayerIds = new();
    private Dictionary<int, decimal> balances = new();
    private int consecutiveFailures;

    private PeriodicTimer? balanceTimer;
    private CancellationTokenSource? balanceTimerCts;
    private Task? balanceTimerTask;

    protected override void OnInitialized()
    {
        balanceTimerCts = new CancellationTokenSource();
        balanceTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        balanceTimerTask = RunBalanceTimerAsync(balanceTimer, balanceTimerCts.Token);
    }

    private async Task<TableData<Player>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        var (items, totalCount) = await PlayerService.GetPagedAsync(search, state.Page, state.PageSize);
        var newPlayerIds = items.Select(p => p.Id).ToList();
        currentPlayerIds = newPlayerIds;

        try
        {
            balances = await PlayerService.GetBalancesAsync(newPlayerIds, cancellationToken);
            consecutiveFailures = 0;
        }
        catch (Exception ex)
        {
            // Balance lookup is a secondary concern for this page - a transient failure here
            // must not crash the whole grid. Leave `balances` as whatever it was (empty on
            // first load); rows just keep showing their last known value or the placeholder.
            Logger.LogWarning(ex, "Failed to load player balances for the current page.");
        }

        return new TableData<Player> { Items = items, TotalItems = totalCount };
    }

    private async Task OnSearchChanged()
    {
        await table.ReloadServerData();
    }

    private async Task RunBalanceTimerAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshBalancesAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on navigation-away / disposal: the timer loop simply stops.
        }
    }

    private async Task RefreshBalancesAsync()
    {
        // The whole read-query-write sequence is dispatched through InvokeAsync so it runs
        // serialized on the circuit's sync context, same as any other component state change -
        // this avoids concurrent access to the scoped ReportingDbContext from a background Task.
        await InvokeAsync(async () =>
        {
            var idsSnapshot = currentPlayerIds;
            Dictionary<int, decimal> newBalances;
            try
            {
                newBalances = await PlayerService.GetBalancesAsync(idsSnapshot, balanceTimerCts?.Token ?? CancellationToken.None);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Balance refresh tick failed.");

                if (!ReferenceEquals(idsSnapshot, currentPlayerIds))
                {
                    // The visible page/search changed while this tick's query was in flight -
                    // the failure doesn't apply to what's on screen now, so don't count it.
                    return;
                }

                var crossedStaleThreshold = ++consecutiveFailures == StaleFailureThreshold;
                if (crossedStaleThreshold)
                {
                    StateHasChanged();
                }
                return;
            }

            if (!ReferenceEquals(idsSnapshot, currentPlayerIds))
            {
                // The page/search changed (or the timer's very first tick raced ahead of the
                // initial ServerReload) while this query was in flight - discard these stale
                // results entirely rather than overwriting balances for the page now on screen.
                return;
            }

            var wasStale = consecutiveFailures >= StaleFailureThreshold;
            var valuesChanged = !BalancesEqual(balances, newBalances);
            balances = newBalances;
            consecutiveFailures = 0;

            if (valuesChanged || wasStale)
            {
                StateHasChanged();
            }
        });
    }

    private static bool BalancesEqual(Dictionary<int, decimal> a, Dictionary<int, decimal> b)
    {
        if (a.Count != b.Count)
        {
            return false;
        }

        foreach (var (playerId, balance) in a)
        {
            if (!b.TryGetValue(playerId, out var otherBalance) || balance != otherBalance)
            {
                return false;
            }
        }

        return true;
    }

    private string GetBalanceText(int playerId) =>
        balances.TryGetValue(playerId, out var balance) ? balance.ToString("C2", BalanceCulture) : "—";

    private string GetBalanceChipStyle(int playerId)
    {
        var color = balances.TryGetValue(playerId, out var balance)
            ? balance switch
            {
                > 0 => PositiveColor,
                < 0 => NegativeColor,
                _ => MutedColor
            }
            : MutedColor;

        return $"background-color: {color}; color: #FFFFFF; font-weight: 600;";
    }

    public async ValueTask DisposeAsync()
    {
        balanceTimerCts?.Cancel();
        balanceTimer?.Dispose();

        if (balanceTimerTask is not null)
        {
            try
            {
                await balanceTimerTask;
            }
            catch (Exception ex)
            {
                // The timer loop already swallows its own OperationCanceledException; anything
                // that reaches here is unexpected, so log it rather than losing it silently.
                Logger.LogWarning(ex, "Balance timer loop did not shut down cleanly.");
            }
        }

        balanceTimerCts?.Dispose();
    }
}
