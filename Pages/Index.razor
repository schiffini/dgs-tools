@page "/"
@attribute [Authorize]

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Solicitudes por estado</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">Datos de muestra (hardcoded) — este pase</MudText>
            <MudChart ChartType="ChartType.Pie" ChartSeries="@RequestsByStatusSeries" ChartLabels="@RequestsByStatusLabels"
                      Height="280" Width="100%" />
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly List<ChartSeries<double>> RequestsByStatusSeries =
    [
        new ChartSeries<double> { Name = "Solicitudes", Data = new double[] { 8, 5, 20, 3 } }
    ];

    private readonly string[] RequestsByStatusLabels = ["Pendiente", "En progreso", "Completada", "Rechazada"];
}
