@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle" OnClick="@(() => Navigation.NavigateTo("Identity/Account/Manage"))">
            @context.User.Identity?.Name
        </MudButton>
        <form action="Identity/Account/LogOut" method="post">
            <button type="submit" class="logout-button">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                <span>Salir</span>
            </button>
        </form>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login" OnClick="@(() => Navigation.NavigateTo("login"))">Iniciar sesión</MudButton>
    </NotAuthorized>
</AuthorizeView>

<style>
    .logout-button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        border: 1px solid currentColor;
        color: inherit;
        border-radius: 4px;
        padding: 6px 16px;
        font: inherit;
        cursor: pointer;
    }

    .logout-button:hover {
        background: rgba(255, 255, 255, 0.1);
    }
</style>
